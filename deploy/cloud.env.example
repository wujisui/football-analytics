# Copy to deploy/cloud.env on the ECS (never commit cloud.env).
# Official API keys stay in the SQLite app_settings table, not here.

API_PROVIDER=api_football
API_BASE_HOST=v3.football.api-sports.io
DATABASE_URL=sqlite+aiosqlite:///./data/football.db
REDIS_ENABLED=false
LOG_LEVEL=INFO
LOG_DIR=logs
SCHEDULER_TIMEZONE=Asia/Shanghai
CLEANUP_DAYS=7
HTTP_VERIFY_SSL=true
LOCAL_FIRST=true
API_HISTORY_MODE=free
ML_MIN_TRAIN_SAMPLES=30
ML_AUTO_TRAIN=true
ML_AH_MIN_TRAIN_SAMPLES=80
ML_AH_AUTO_TRAIN=true

# HTTP-only IP access: keep false. Set true after HTTPS is on the same host.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Same-origin via nginx usually does not need CORS, but cookie auth still
# requires an explicit list. Replace with http://YOUR_ECS_IP and/or https://domain.
CORS_ALLOW_ORIGINS=http://127.0.0.1,http://localhost
