# Non-secret local config. Prefer putting API keys in secrets.local.env.
API_PROVIDER=api_football
API_BASE_HOST=v3.football.api-sports.io
API_ENDPOINT_LEAGUES=/leagues
API_ENDPOINT_TEAMS=/teams
API_ENDPOINT_FIXTURES=/fixtures
API_ENDPOINT_FIXTURE_DETAIL=/fixtures
API_ENDPOINT_QUOTA=/status
API_ENDPOINT_HEADTOHEAD=/fixtures/headtohead
API_ENDPOINT_TEAM_STATISTICS=/teams/statistics
API_ENDPOINT_ODDS=/odds
API_ENDPOINT_LINEUPS=/fixtures/lineups
API_ENDPOINT_INJURIES=/injuries
API_ENDPOINT_PREDICTIONS=/predictions
DATABASE_URL=sqlite+aiosqlite:///./data/football.db
REDIS_URL=redis://localhost:6379
# Local default: skip Redis connect attempts (use in-memory cache).
REDIS_ENABLED=false
LOG_LEVEL=INFO
LOG_DIR=logs
SCHEDULER_TIMEZONE=Asia/Shanghai
CLEANUP_DAYS=7
HTTP_VERIFY_SSL=false
LOCAL_FIRST=true
# Env default only; admin UI can override at runtime (persisted in app_settings).
ENABLE_SCHEDULED_FULL_DETAIL=false
# Optional fallback for /api/v1/admin/* scripts (X-Admin-Key). Prefer
# `python manage.py set-admin <account>` so the Mine UI uses the login session.
# ADMIN_API_KEY=change-me
# Auth session cookie (httpOnly). MUST be true once served over HTTPS.
SESSION_COOKIE_SECURE=false
# SESSION_COOKIE_NAME=fa_session
# SESSION_COOKIE_SAMESITE=lax
# Credentialed browser origins; cookie auth forbids "*". Add your prod domain.
CORS_ALLOW_ORIGINS=http://localhost:7800,http://127.0.0.1:7800
# full = paid plan（H2H 不限年份、赛程窗口不裁剪）；free = 免费套餐（默认）
# 本地若仍用免费 Key，务必保持 free，否则会按付费窗口打官方并很快耗尽日配额。
API_HISTORY_MODE=free
# ML: accumulate local FT labels from now; auto-train & switch when enough.
ML_MIN_TRAIN_SAMPLES=30
ML_AUTO_TRAIN=true
ML_AH_MIN_TRAIN_SAMPLES=80
ML_AH_AUTO_TRAIN=true
# Optional: override league catalog as JSON array (else use config/leagues.json).
# LEAGUES_JSON=[{"name":"英超","id":39,"country":"England"}]
