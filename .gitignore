# Local IDE
.idea/

# Local Python virtualenv (never commit)
.venv/

# Runtime logs (backend writes under backend/logs/; ignore any repo-root logs too)
logs/

# Local secrets (belt-and-suspenders; also ignored under backend/)
**/.env
**/secrets.local.env
**/*.local.env
!**/.env.example
!**/secrets.local.env.example

# Trained model artifacts (regenerate via `python manage.py train-model`)
backend/data/models/

# Cloud runtime env (copy from deploy/cloud.env.example)
deploy/cloud.env

# Consistent SQLite export used only for uploading to ECS
backend/data/football.export.db
